name: ankh_lens
description: AnkhLens — offline-first Egyptian hieroglyph scanner and tourist companion.
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.3.0 <4.0.0'
  flutter: '>=3.19.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter

  # State management / DI
  flutter_riverpod: ^2.5.1
  riverpod_annotation: ^2.3.5

  # Navigation
  go_router: ^14.2.0

  # Offline structured storage
  drift: ^2.18.0
  sqlite3_flutter_libs: ^0.5.24
  path_provider: ^2.1.3
  path: ^1.9.0

  # Camera + on-device ML
  camera: ^0.11.0
  tflite_flutter: ^0.11.0
  image: ^4.2.0

  # Cartouche rendering / sharing
  flutter_svg: ^2.0.10
  share_plus: ^9.0.0

  # Audio
  just_audio: ^0.9.40

  # i18n
  intl: ^0.19.0

  # Security
  flutter_secure_storage: ^9.2.2

  # Connectivity (for optional online sync fallback)
  connectivity_plus: ^6.0.3

  # Models / serialization
  equatable: ^2.0.5
  freezed_annotation: ^2.4.4
  json_annotation: ^4.9.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter

  build_runner: ^2.4.11
  riverpod_generator: ^2.4.0
  freezed: ^2.5.5
  json_serializable: ^6.8.0
  drift_dev: ^2.18.0

  mocktail: ^1.0.4
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true
  generate: true   # enables gen-l10n from .arb files

  assets:
    - assets/glyphs/
    - assets/models/
    - assets/audio/
    - assets/branding/
    - assets/localization/

  fonts:
    - family: AnkhDisplay
      fonts:
        - asset: assets/fonts/AnkhDisplay-Regular.ttf
        - asset: assets/fonts/AnkhDisplay-Bold.ttf
          weight: 700
    - family: AnkhBody
      fonts:
        - asset: assets/fonts/AnkhBody-Regular.ttf
        - asset: assets/fonts/AnkhBody-Italic.ttf
          style: italic
sequenceDiagram
    participant U as Tourist
    participant UI as ScannerScreen
    participant C as ScannerController
    participant UC as DetectGlyphsUseCase
    participant ML as MLInferenceService (TFLite)
    participant Dict as DictionaryRepository (Drift)

    U->>UI: Points camera / taps capture
    UI->>C: onFrameCaptured(frame)
    C->>UC: execute(frame)
    UC->>ML: preprocess + infer(frame)
    ML-->>UC: List<RawDetection> (bbox, classId, score)
    UC->>UC: confidence filtering + NMS
    UC->>Dict: getByGardinerCode(classId)
    Dict-->>UC: GlyphEntry(s)
    UC-->>C: List<DetectionResult>
    C-->>UI: ScannerState.success(results)
    UI->>U: Draws bounding boxes + opens ResultSheet
