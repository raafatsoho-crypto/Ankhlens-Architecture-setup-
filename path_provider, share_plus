// domain/services/cartouche_export_service.dart

abstract class CartoucheExportService {
  /// Encodes the given image as PNG and writes it to a temp/cache file,
  /// returning the file path. Does not present any UI.
  Future<String> saveToTempFile(ui.Image image, {String? filename});

  /// Triggers the platform share sheet for an already-saved PNG file.
  Future<ShareResult> share(String filePath, {String? subject});
}

enum ShareResultStatus { success, dismissed, unavailable, error }

class ShareResult {
  final ShareResultStatus status;
  final String? errorMessage;

  const ShareResult({required this.status, this.errorMessage});
}
// data/services/cartouche_export_service_impl.dart

class CartoucheExportServiceImpl implements CartoucheExportService {
  @override
  Future<String> saveToTempFile(ui.Image image, {String? filename}) async {
    final byteData = await image.toByteData(format: ui.ImageByteFormat.png);
    if (byteData == null) {
      throw CartoucheExportException('Failed to encode image as PNG');
    }

    final bytes = byteData.buffer.asUint8List();
    final dir = await getTemporaryDirectory();
    final name = filename ?? 'cartouche_${DateTime.now().millisecondsSinceEpoch}.png';
    final file = File('${dir.path}/$name');

    await file.writeAsBytes(bytes, flush: true);
    return file.path;
  }

  @override
  Future<ShareResult> share(String filePath, {String? subject}) async {
    try {
      final result = await Share.shareXFiles(
        [XFile(filePath)],
        subject: subject ?? 'My Cartouche',
      );

      switch (result.status) {
        case ShareResultStatus.success:
          return const ShareResult(status: ShareResultStatus.success);
        case ShareResultStatus.dismissed:
          return const ShareResult(status: ShareResultStatus.dismissed);
        default:
          return const ShareResult(status: ShareResultStatus.unavailable);
      }
    } catch (e) {
      return ShareResult(status: ShareResultStatus.error, errorMessage: e.toString());
    }
  }
}

class CartoucheExportException implements Exception {
  final String message;
  CartoucheExportException(this.message);
  @override
  String toString() => 'CartoucheExportException: $message';
}
